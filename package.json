{
  "name": "crazyuno",
  "private": true,
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm test -w shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w client",
    "start": "node scripts/start.mjs",
    "bots": "tsx scripts/bots.mts",
    "e2e": "node scripts/e2e/play.mjs",
    "e2e:sfx": "node scripts/e2e/sfx.mjs",
    "e2e:rejoin": "node scripts/e2e/rejoin.mjs",
    "e2e:discord": "node scripts/e2e/discord.mjs",
    "e2e:layout": "node scripts/e2e/layout.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~5.9.3"
  }
}
